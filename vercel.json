{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "30mb" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
